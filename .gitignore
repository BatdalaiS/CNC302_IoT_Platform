lab02/registry/firmware/

# Сертификатууд (Лаб 2-т үүсгэнэ)
stack/emqx/certs/*
!stack/emqx/certs/.gitkeep
lab02/certs/*
!lab02/certs/.gitkeep

# Хэмжилтийн гаралт — тайланд хэрэгтэй хэсгийг нь гараар нэмнэ
measurements/
*.csv.raw

# Лаб 8 — компьютер дээр барьсан arm64 дүрсийн архив (том)
