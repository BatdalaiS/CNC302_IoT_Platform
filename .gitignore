# Нууц ба орчны файлууд — ХЭЗЭЭ Ч commit хийхгүй
stack/.env
edge/.env
**/*.key
**/*.pem
**/*_key
secrets/

# Ирмэгийн гүүрний тохиргоо — LAN IP ба нэвтрэлт агуулна.
# Загвар нь (.template) Git-д байна; үүсгэсэн файл нь ОРОХГҮЙ.
edge/mosquitto/conf.d/bridge.conf

# Бүртгэлийн үйлчилгээний өгөгдөл (SQLite, firmware дүрс)
