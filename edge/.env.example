# CNC302 — ирмэгийн давхаргын тохиргоо (RASPBERRY PI 3B)
#
#   cp .env.example .env
#   nano .env            ← CLOUD_HOST-ыг ЗААВАЛ солино
#   make bridge          ← conf.d/bridge.conf үүснэ
#   make up

# ── Үүлний хаяг ─────────────────────────────────────────────────────────────
# Зөөврийн компьютерийнхээ LAN IP. Компьютер дээрээ `make ip` ажиллуулж авна.
# ⚠ localhost эсвэл 127.0.0.1 БИШ — тэр нь Pi өөрийгөө заана.
CLOUD_HOST=192.168.1.100
CLOUD_PORT=1883

# ── Unified Namespace дахь байрлал ──────────────────────────────────────────
# UNS сэдэв: cnc302/<SITE>/<AREA>/<LINE>/<DEVICE_ID>/<channel>
SITE=shutis
AREA=mhts
LINE=lab
DEVICE_ID=pi3b-01          # баг бүр өөр байх ёстой: pi3b-team03 гэх мэт

# ── Агентын тохиргоо ────────────────────────────────────────────────────────
INTERVAL=2.0               # телеметрийн үе (сек)
MQTT_HOST=localhost        # ирмэгийн брокер (агент Pi дээр ажиллана)
MQTT_PORT=1883

# ── Лаб 6: ирмэгийн дүгнэлт ─────────────────────────────────────────────────
MODEL_PATH=../lab06/models/anomaly_int8.tflite
INFER_THREADS=2            # Pi 3B-д 4 цөм бий, гэхдээ 2 нь илүү тогтвортой
