# CNC302 — ирмэгийн давхаргын тохиргоо (RASPBERRY PI 3B)
#
#   cp .env.example .env
#   nano .env            ← CLOUD_HOST-ыг ЗААВАЛ солино
#   make bridge          ← conf.d/bridge.conf үүснэ
#   make up
#
# ⚠ Энэ файлыг гурван өөр зүйл уншдаг: bash (`make` → source), Docker Compose,
#   systemd (EnvironmentFile=). systemd нь мөрийн ДУНДАХ `#`-ийг тайлбар гэж
#   үздэггүй — утгын нэг хэсэг болгоно. Тиймээс тайлбарыг ЗӨВХӨН тусдаа мөрөнд
#   бичиж, утгыг хашилтгүй, хоосон зайгүй үлдээнэ.

# ── Үүлний хаяг ─────────────────────────────────────────────────────────────
# Зөөврийн компьютерийнхээ LAN IP. Компьютер дээрээ `make ip` ажиллуулж авна.
# ⚠ localhost эсвэл 127.0.0.1 БИШ — тэр нь Pi өөрийгөө заана.
CLOUD_HOST=192.168.1.100
CLOUD_PORT=1883

# Сонголттой: EMQX-ийн нэвтрэлтийг байнга асаасан үед л гүүрт хэрэгтэй
# (bridge.conf.template-ийн remote_username/remote_password).
CLOUD_MQTT_USERNAME=
CLOUD_MQTT_PASSWORD=

# ── Unified Namespace дахь байрлал ──────────────────────────────────────────
# UNS сэдэв: cnc302/<SITE>/<AREA>/<LINE>/<DEVICE_ID>/<channel>
SITE=shutis
AREA=mhts
LINE=lab
# Баг бүр өөр байх ёстой: pi3b-team03 гэх мэт
DEVICE_ID=pi3b-01

# ── Агентын тохиргоо ────────────────────────────────────────────────────────
# Телеметрийн үе (сек)
INTERVAL=2.0
# Ирмэгийн брокер (агент Pi дээр ажиллана)
MQTT_HOST=localhost
MQTT_PORT=1883

# ── Лаб 6: ирмэгийн дүгнэлт ─────────────────────────────────────────────────
MODEL_PATH=../lab06/models/model_int8.tflite
# Pi 3B-д 4 цөм бий; 2 урсгал ихэвчлэн илүү тогтвортой (Лаб 6-д хэмжинэ)
INFER_THREADS=2
