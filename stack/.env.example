# CNC302 — орчны хувьсагч. Энэ файлыг .env болгон хуулж утгыг солино.
# .env файлыг Git санд ХЭЗЭЭ Ч оруулахгүй (.gitignore-д бүртгэгдсэн).

# EMQX
EMQX_COOKIE=cnc302-солино-энэ-мөрийг
EMQX_DASHBOARD_PASSWORD=солино-хүчтэй-нууц-үг

# Grafana
GRAFANA_PASSWORD=солино-хүчтэй-нууц-үг

# ThingsBoard (анхны админ: tenant@thingsboard.org / tenant)
TB_USER=tenant@thingsboard.org
TB_PASSWORD=tenant

# InfluxDB
INFLUX_DB=cnc302
