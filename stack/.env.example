# CNC302 — үүлний давхаргын нууц утгууд (ЗӨӨВРИЙН КОМПЬЮТЕР)
#
#   cp .env.example .env
#   # дараа нь бүх утгыг СОЛИНО
#
# ⚠ .env файлыг Git-д ХЭЗЭЭ Ч оруулахгүй. .gitignore-д бэлэн байгаа.

# ── EMQX ────────────────────────────────────────────────────────────────────
EMQX_COOKIE=solio-energiig-end-buu-uldee
EMQX_DASHBOARD_PASSWORD=solio-nuuts-ug-2026

# EMQX-ийн REST API түлхүүр. Лаб 2-т самбараас үүсгэнэ:
#   http://localhost:18083 → System → API Key → Create
EMQX_API_KEY=
EMQX_API_SECRET=

# Лаб 2-ын mTLS хэсэгт true болгоно. Сертификат: ./emqx/certs/{ca.crt,server.crt,server.key}
EMQX_TLS_ENABLE=false

# Сонголттой: EMQX-ийн нэвтрэлтийг Лаб 2-оос хойш байнга асаавал registry-ийн
# MQTT хэрэглэгч. Хоосон бол нэвтрэлтгүй холбогдоно.
REGISTRY_MQTT_USERNAME=
REGISTRY_MQTT_PASSWORD=

# ── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=solio-nuuts-ug-2026

# ── InfluxDB ────────────────────────────────────────────────────────────────
INFLUX_DB=cnc302

# ── Лаб 7: OIDC ─────────────────────────────────────────────────────────────
OIDC_CLIENT_SECRET=solio-client-secret
# Dex-ийн токены aud = client id (dex/config.yaml → staticClients.id)
JWT_AUDIENCE=cnc302

# ── Лаб 8: Ollama ───────────────────────────────────────────────────────────
OLLAMA_MODEL=qwen2.5:1.5b
