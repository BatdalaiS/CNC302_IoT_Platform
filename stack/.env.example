# CNC302 — үүлний давхаргын нууц утгууд (ЗӨӨВРИЙН КОМПЬЮТЕР)
#
#   cp .env.example .env
#   # дараа нь бүх утгыг СОЛИНО
#
# ⚠ .env файлыг Git-д ХЭЗЭЭ Ч оруулахгүй. .gitignore-д бэлэн байгаа.

# ── EMQX ────────────────────────────────────────────────────────────────────
EMQX_COOKIE=solio-energiig-end-buu-uldee
EMQX_DASHBOARD_PASSWORD=solio-nuuts-ug-2026

# EMQX-ийн REST API түлхүүр. Лаб 2-т самбараас үүсгэнэ:
#   http://localhost:18083 → System → API Key → Create
EMQX_API_KEY=
EMQX_API_SECRET=

# Лаб 2-ын mTLS хэсэгт true болгоно
EMQX_TLS_ENABLE=false

# ── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=solio-nuuts-ug-2026

# ── InfluxDB ────────────────────────────────────────────────────────────────
INFLUX_DB=cnc302

# ── Лаб 7: OIDC ─────────────────────────────────────────────────────────────
OIDC_CLIENT_SECRET=solio-client-secret
JWT_AUDIENCE=cnc302-app

# ── Лаб 8: Ollama ───────────────────────────────────────────────────────────
OLLAMA_MODEL=qwen2.5:1.5b
